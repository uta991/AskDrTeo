{
  "expo": {
    "name": "AskDrTeo",
    "slug": "askdrteo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "askdrteo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF6DC",
      "image": "./assets/images/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ge.askdrteo.app"
    },
    "android": {
      "package": "ge.askdrteo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF6DC",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "აპლიკაციას ბავშვის ფოტოს ასარჩევად სჭირდება გალერეაზე წვდომა."
        }
      ],
      "./plugins/withoutAppleSignIn"
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1",
      "googleClientIds": {
        "ios": "",
        "android": "",
        "web": ""
      }
    },
    "icon": "./assets/images/icon.png"
  }
}
