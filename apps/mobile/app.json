{
  "expo": {
    "name": "AskDrTeo",
    "slug": "askdrteo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "askdrteo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "image": "./assets/images/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ge.askdrteo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ვიდეო ვიზიტისთვის აპლიკაციას კამერაზე წვდომა სჭირდება.",
        "NSMicrophoneUsageDescription": "ვიდეო ვიზიტისთვის აპლიკაციას მიკროფონზე წვდომა სჭირდება.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "ge.askdrteo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "აპლიკაციას ბავშვის ფოტოს ასარჩევად სჭირდება გალერეაზე წვდომა."
        }
      ],
      "./plugins/withoutAppleSignIn"
    ],
    "extra": {
      "apiUrl": "https://api.askdrteo.com/api/v1",
      "googleClientIds": {
        "ios": "856661530961-1pnn07575f43ierd3ceo4ldvp1kkcvlb.apps.googleusercontent.com",
        "android": "",
        "web": "856661530961-mdaus6nmbsntp6l472lujndb0o48epc9.apps.googleusercontent.com"
      }
    },
    "icon": "./assets/images/icon.png"
  }
}
