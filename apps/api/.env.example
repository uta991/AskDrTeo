# ─── აპლიკაცია ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── ბაზა ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baby_pediatry?schema=public"

# ─── JWT ─────────────────────────────────────────────────────
# პროდაქშენზე აუცილებლად შეცვალე: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ─── OTP ─────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─── SMS provider ────────────────────────────────────────────
# console = კოდი მხოლოდ ლოგში იბეჭდება (development)
SMS_PROVIDER=console
SMS_SENDER_NAME=BabyCare
SMS_API_KEY=
SMS_API_URL=

# ─── Google Sign-In ──────────────────────────────────────────
# მძიმით გამოყოფილი: web, iOS და Android client ID-ები
GOOGLE_CLIENT_IDS="your-web-client-id.apps.googleusercontent.com"

# ─── Apple Sign-In ───────────────────────────────────────────
# iOS-ზე audience = აპლიკაციის Bundle ID
# ვებზე (მოგვიანებით) დაემატება Services ID, მძიმით გამოყოფილი
APPLE_CLIENT_IDS="ge.askdrteo.app"

# ─── საცავი ──────────────────────────────────────────────────
# local = ლოკალური დისკი (მხოლოდ დეველოპმენტში)
FILE_STORAGE_DRIVER=local
VIDEO_STORAGE_DRIVER=local

# ─── Cloudflare R2 (FILE_STORAGE_DRIVER=r2) ──────────────────
R2_ACCOUNT_ID=
R2_BUCKET=askdrteo
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# bucket-ის საჯარო დომენი, მაგ: https://media.askdrteo.ge
R2_PUBLIC_URL=

# ─── Bunny Stream (VIDEO_STORAGE_DRIVER=bunny) ───────────────
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# ბიბლიოთეკის CDN დომენი, მაგ: vz-xxxxx.b-cdn.net
BUNNY_CDN_HOST=
# არასავალდებულო — token authentication ჩართვისას
BUNNY_TOKEN_KEY=

# webhook-ის საიდუმლო — ჩვენ ვქმნით, Bunny-ს მისამართში ვაწვდით
BUNNY_WEBHOOK_SECRET=

# ─── სატესტო ნომრები ─────────────────────────────────────────
# ნომერი:კოდი, მძიმით გამოყოფილი. ამ ნომრებზე SMS არ იგზავნება და
# კოდი ყოველთვის ერთი და იგივეა — რეალური provider-ის ჩართვამდე.
OTP_TEST_NUMBERS=+995599000000:123456
