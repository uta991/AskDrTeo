# ─── აპლიკაცია ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── ბაზა ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baby_pediatry?schema=public"

# ─── JWT ─────────────────────────────────────────────────────
# პროდაქშენზე აუცილებლად შეცვალე: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ─── OTP ─────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─── SMS provider ────────────────────────────────────────────
# console   = კოდი არსად იგზავნება, მხოლოდ backend-ის ტერმინალში იბეჭდება
#             (ამ დროს რეგისტრაცია დადასტურების გარეშე სრულდება)
# smsoffice = SMSOffice.ge — SMS_API_KEY აუცილებელია, SMS_SENDER_NAME
#             უნდა იყოს იქ დარეგისტრირებული გამგზავნის სახელი
# twilio    = SMS_ACCOUNT_SID + SMS_API_KEY (auth token),
#             SMS_SENDER_NAME = Twilio-ს ნომერი +1XXXXXXXXXX ფორმატში
SMS_PROVIDER=console
SMS_SENDER_NAME=BabyCare
SMS_API_KEY=
SMS_ACCOUNT_SID=
# ცარიელი = provider-ის ნაგულისხმევი მისამართი
SMS_API_URL=

# ─── Google Sign-In ──────────────────────────────────────────
# მძიმით გამოყოფილი: web, iOS და Android client ID-ები
GOOGLE_CLIENT_IDS="your-web-client-id.apps.googleusercontent.com"

# ─── Apple Sign-In ───────────────────────────────────────────
# iOS-ზე audience = აპლიკაციის Bundle ID
# ვებზე (მოგვიანებით) დაემატება Services ID, მძიმით გამოყოფილი
APPLE_CLIENT_IDS="ge.askdrteo.app"

# ─── საცავი ──────────────────────────────────────────────────
# local = ლოკალური დისკი (მხოლოდ დეველოპმენტში)
FILE_STORAGE_DRIVER=local
VIDEO_STORAGE_DRIVER=local

# ─── Cloudflare R2 (FILE_STORAGE_DRIVER=r2) ──────────────────
R2_ACCOUNT_ID=
R2_BUCKET=askdrteo
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# bucket-ის საჯარო დომენი, მაგ: https://media.askdrteo.ge
R2_PUBLIC_URL=

# ─── Bunny Stream (VIDEO_STORAGE_DRIVER=bunny) ───────────────
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# ბიბლიოთეკის CDN დომენი, მაგ: vz-xxxxx.b-cdn.net
BUNNY_CDN_HOST=
# არასავალდებულო — token authentication ჩართვისას
BUNNY_TOKEN_KEY=

# webhook-ის საიდუმლო — ჩვენ ვქმნით, Bunny-ს მისამართში ვაწვდით
BUNNY_WEBHOOK_SECRET=

# ─── სატესტო ნომრები ─────────────────────────────────────────
# ნომერი:კოდი, მძიმით გამოყოფილი. ამ ნომრებზე SMS არ იგზავნება და
# კოდი ყოველთვის ერთი და იგივეა — რეალური provider-ის ჩართვამდე.
OTP_TEST_NUMBERS=+995599000000:123456

# ─── SMS Gateway (sms-gate.app) ──────────────────────────────
# Android ტელეფონი რეალური SIM-ით — იმავე ნომრიდან იგზავნება.
SMS_GATE_USER=
SMS_GATE_PASSWORD=
SMS_GATE_DEVICE_ID=
SMS_GATE_URL=https://api.sms-gate.app/3rdparty/v1/messages
ALLOW_UNVERIFIED_SIGNUP=false

# ─── AI ასისტენტი (პრემიუმ პაკეტი) ───────────────────────────
# ცარიელი გასაღები = ასისტენტი გამორთულია და აპლიკაცია ამას ღიად ამბობს.
# გასაღები იხსნება console.anthropic.com-ზე.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=2000
# დღიური შეკითხვა ერთ მშობელზე; 0 = შეზღუდვის გარეშე.
# სატესტო ეტაპზე გამორთულია — გაშვებამდე 10-ზე დავაბრუნოთ.
AI_DAILY_LIMIT=10
# ლიმიტის გარეშე — ტესტის ანგარიშები, მძიმით გამოყოფილი
AI_UNLIMITED_EMAILS=buziashviliuta@gmail.com,tevo@gmail.com

# ─── TBC — ბარათით გადახდა ───────────────────────────────────
# Client ID / Secret: TBC E-Commerce merchant dashboard
# API Key: developers.tbcbank.ge → შენი აპლიკაცია
# სამივე მხოლოდ backend-შია. ბრაუზერს არასდროს გადაეცემა.
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_API_KEY=
TBC_API_URL=https://api.tbcbank.ge
TBC_RETURN_URL=https://askdrteo.com/payment/result
# ბანკის callback-ისთვის — API-ს საჯარო მისამართი (https სავალდებულოა)
PUBLIC_URL=https://api.askdrteo.com

# ─── ვიდეო ვიზიტი (Agora) ────────────────────────────────────
# console.agora.io → Project → App ID და Primary Certificate
# App Certificate მხოლოდ backend-შია — კლიენტს მოკლევადიანი ტოკენი
# გადაეცემა, გასაღები არასდროს.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
