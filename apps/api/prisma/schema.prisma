// ─────────────────────────────────────────────────────────────────────────────
// Baby Pediatry — მონაცემთა ბაზის სქემა
// PostgreSQL + Prisma
//
// მთავარი პრინციპი: პაკეტები, ფასები და უფლებები კოდში არ არის ჩაშენებული.
// ყველაფერს Super Admin მართავს ბაზიდან (Feature / Plan / PlanFeature).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// 1. მომხმარებლები, როლები, ავთენტიფიკაცია
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  PARENT
  OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  email        String? @unique
  phone        String? @unique // E.164 ფორმატი: +9955XXXXXXXX
  passwordHash String? // null = მხოლოდ სოციალური ავტორიზაცია

  /// ორეტაპიანი შესვლა. პერსონალს ყოველთვის ჩართული აქვს, მშობელს —
  /// ნაგულისხმევად, პროფილიდან გამორთვის შესაძლებლობით.
  twoFactorEnabled Boolean @default(true)

  /// კოდის მიმღები ნომერი, თუ შესვლის ნომრისგან განსხვავდება.
  ///
  /// `phone` უნიკალურია — ის შესვლის იდენტიფიკატორია და ორ ანგარიშზე
  /// ვერ იქნება. ერთი ფიზიკური ტელეფონი კი შეიძლება რამდენიმე
  /// ანგარიშის კოდს იღებდეს (მაგ. ადმინი და საკუთარი მშობლის პროფილი),
  /// ამიტომ ეს ველი უნიკალური არაა.
  twoFactorPhone String?

  /// ზედიზედ არასწორი პაროლები. ბაზაშია და არა მეხსიერებაში —
  /// სერვერის რესტარტი თავდამსხმელს არ უნდა შველოდეს.
  failedLoginAttempts Int        @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  /// ბოლო გაფრთხილება მფლობელს — რომ SMS-ითაც არ დაიბომბოს
  lastLockAlertAt     DateTime?
  role                UserRole   @default(PARENT)
  status              UserStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  avatarUrl       String?
  locale          String    @default("ka")
  timezone        String    @default("Asia/Tbilisi")

  acceptedTermsAt    DateTime?
  termsVersion       String?
  marketingConsentAt DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  identities         AuthIdentity[]
  sessions           Session[]
  otpCodes           OtpCode[]
  children           Child[]
  subscriptions      Subscription[]
  payments           Payment[]
  watchProgress      WatchProgress[]
  videoViews         VideoView[]
  favorites          VideoFavorite[]
  devices            Device[]
  notifications      Notification[]
  smsMessages        SmsMessage[]
  auditLogs          AuditLog[]                     @relation("AuditActor")
  newsPosts          NewsPost[]                     @relation("NewsAuthor")
  promoCodes         PromoCode[]                    @relation("PromoAuthor")
  promoRedemptions   PromoRedemption[]
  mediaAssets        MediaAsset[]
  conversations      ConversationUser[]
  loginChallenges    LoginChallenge[]
  trustedDevices     TrustedDevice[]
  aiConversations    AiConversation[]
  appointments       Appointment[]
  consultationPacks  ConsultationPack[]
  videoVisits        VideoVisit[]                   @relation("VideoVisitParent")
  videoVisitsAsStaff VideoVisit[]                   @relation("VideoVisitStaff")
  videoVisitCredits  VideoVisitCredit[]
  chatFeedback       ConversationFeedback[]
  feedbackAsOperator ConversationFeedback[]         @relation("FeedbackOperator")
  feedbackShares     ConversationFeedbackOperator[]
  messages           Message[]
  operatorProfile    OperatorProfile?

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

// ოპერატორის დამატებითი ინფორმაცია (ექიმი / კონსულტანტი)
model OperatorProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String?
  bio            String?
  isAvailable    Boolean @default(true)
  maxActiveChats Int     @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("operator_profiles")
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

// სოციალური ავტორიზაციის მიბმა — ერთ user-ს რამდენიმე provider შეიძლება ჰქონდეს
model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

// Refresh token სესიები — logout / "ყველა მოწყობილობიდან გასვლა"-სთვის
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceId         String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("sessions")
}

enum OtpPurpose {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

model OtpCode {
  id          String     @id @default(uuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String // ტელეფონი ან ელ. ფოსტა
  codeHash    String
  purpose     OtpPurpose
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, purpose, consumedAt])
  @@map("otp_codes")
}

// ═══════════════════════════════════════════════════════════════════════════
// 1.5 უფლებები — როლი მხოლოდ უფლებების ნაკრებია
// ═══════════════════════════════════════════════════════════════════════════

/**
 * უფლებების კატალოგი.
 * კოდი როლს არ ამოწმებს — მხოლოდ უფლების key-ს:
 * permissions.assert(userId, 'video.create')
 * ასე Super Admin-ს პანელიდან შეუძლია ოპერატორს chat.reply დაუტოვოს
 * და subscription.manage ჩამოართვას, კოდის შეხების გარეშე.
 */
model Permission {
  id          String  @id @default(uuid())
  /// "video.create", "chat.reply" — მუდმივი იდენტიფიკატორი
  key         String  @unique
  /// ჯგუფი ინტერფეისისთვის: "video", "chat", "user"
  group       String
  name        String
  description String?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([group, sortOrder])
  @@map("permissions")
}

/**
 * როლი ↔ უფლება.
 * SUPER_ADMIN აქ განზრახ არ მონაწილეობს: მას ყველა უფლება
 * ავტომატურად აქვს. თუ ბაზაზე იქნებოდა დამოკიდებული, ახალი უფლების
 * დამატებისას seed-ში მისი მიბმის დავიწყება Super Admin-ს საკუთარ
 * სისტემაში შეზღუდავდა.
 */
model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedById String?
  createdAt   DateTime @default(now())

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════════════════
// 2. ბავშვის პროფილი
// ═══════════════════════════════════════════════════════════════════════════

/**
 * მშობლის როლი ბავშვთან.
 * ანგარიში დედასაც შეიძლება ეკუთვნოდეს და მამასაც — დოკუმენტში
 * „დედა" ყოველ შემთხვევაში ვერ დაიწერება.
 */
enum ParentRole {
  MOTHER
  FATHER
  GUARDIAN
  UNSPECIFIED
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

model Child {
  id         String     @id @default(uuid())
  parentId   String
  parent     User       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  /// ანგარიშის მფლობელი ამ ბავშვის დედაა თუ მამა
  parentRole ParentRole @default(UNSPECIFIED)
  firstName  String
  lastName   String?
  birthDate  DateTime
  gender     Gender     @default(UNSPECIFIED)

  /// ფოტო კერძოა — ბმული ყოველ ჯერზე ხელმოწერით გამოაქვს.
  /// გაუთვალისწინებელი საჯარო URL bearer-ბმულია: ვინც მიიღებს,
  /// ავტორიზაციის გარეშე ნახავს. ბავშვის ფოტოზე ეს დაუშვებელია.
  avatarAssetId   String?
  avatarAsset     MediaAsset?           @relation("ChildAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  assessments     MilestoneAssessment[]
  aiConversations AiConversation[]
  growthEntries   GrowthEntry[]

  /// როდის შეავსო მშობელმა აცრების ისტორია — შევსებამდე ვთხოვთ შევსებას
  vaccinationHistoryAt DateTime?
  vaccinations         ChildVaccination[]
  travelChecklist      TravelChecklist?
  appointments         Appointment[]

  /// ორსულობის კვირა დაბადებისას — ნაადრევად დაბადებულის საჭიროებები განსხვავდება
  gestationalWeek Int?
  birthWeight     Decimal? @db.Decimal(5, 2) // კგ
  birthHeight     Decimal? @db.Decimal(5, 2) // სმ

  /// მშობლების მონაცემები — მემკვიდრეობითი რისკებისა და ბარათის იდენტიფიკაციისთვის
  motherFirstName String?
  motherLastName  String?
  motherBirthDate DateTime?
  fatherFirstName String?
  fatherLastName  String?
  fatherBirthDate DateTime?

  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  videoVisits VideoVisit[]

  @@index([parentId])
  @@map("children")
}

// ═══════════════════════════════════════════════════════════════════════════
// 3. ფუნქციები, პაკეტები, გამოწერები  ← სისტემის გული
// ═══════════════════════════════════════════════════════════════════════════

enum FeatureType {
  BOOLEAN // ჩართული / გამორთული (მაგ. chat_with_operator)
  LIMIT // რიცხვითი ლიმიტი (მაგ. max_children = 3)
  ACCESS // კონტენტზე წვდომა (მაგ. video_category:newborn)
}

// ფუნქციების კატალოგი. ახალი ფუნქცია = ახალი ჩანაწერი, კოდის ცვლილების გარეშე.
// კოდში მხოლოდ key-ს ვამოწმებთ: entitlements.can('chat_with_operator')
model Feature {
  id           String      @id @default(uuid())
  key          String      @unique // snake_case, მუდმივი იდენტიფიკატორი
  name         String
  description  String?
  type         FeatureType @default(BOOLEAN)
  unit         String? // LIMIT-ისთვის: "videos/month", "children"
  defaultValue String? // უფასო მომხმარებლის ნაგულისხმევი მნიშვნელობა
  isActive     Boolean     @default(true)
  /// პაკეტების სიაში ჩანს თუ არა. ატვირთვის ლიმიტები ტექნიკურია —
  /// კონტროლს ექვემდებარება, მაგრამ მშობელს ვიტრინაში არ სჭირდება.
  isPublic     Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  plans PlanFeature[]

  @@map("features")
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Plan {
  id          String     @id @default(uuid())
  code        String     @unique // "free", "standard", "premium"
  name        String
  description String?
  status      PlanStatus @default(DRAFT)
  isFree      Boolean    @default(false)
  isDefault   Boolean    @default(false) // ახალი მომხმარებლის ავტომატური პაკეტი
  trialDays   Int        @default(0)

  // ვიზუალი — Super Admin მართავს, აპლიკაცია მხოლოდ ხატავს
  badge     String? // "პოპულარული"
  colorHex  String?
  iconUrl   String?
  highlight Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  prices        PlanPrice[]
  features      PlanFeature[]
  subscriptions Subscription[]
  videoAccess   VideoPlanAccess[]
  promoCodes    PromoCode[]

  @@index([status])
  @@map("plans")
}

enum BillingInterval {
  MONTH
  YEAR
  ONE_TIME
}

// ერთ პაკეტს შეიძლება ჰქონდეს რამდენიმე ფასი (თვიური / წლიური / სხვა ვალუტა)
model PlanPrice {
  id            String          @id @default(uuid())
  planId        String
  plan          Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency      String          @default("GEL")
  amountMinor   Int // თეთრებში — მცურავი წერტილი ფულთან არასდროს
  interval      BillingInterval @default(MONTH)
  intervalCount Int             @default(1)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  subscriptions Subscription[]

  @@unique([planId, currency, interval, intervalCount])
  @@map("plan_prices")
}

// პაკეტი ↔ ფუნქცია. აქ წყდება "რა შედის პაკეტში".
model PlanFeature {
  id        String  @id @default(uuid())
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  enabled   Boolean @default(true)
  value     String? // LIMIT-ისთვის: "3", "unlimited"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureId])
  @@map("plan_features")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan               @relation(fields: [planId], references: [id])
  planPriceId String?
  planPrice   PlanPrice?         @relation(fields: [planPriceId], references: [id])
  status      SubscriptionStatus @default(ACTIVE)

  startedAt          DateTime  @default(now())
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  cancelReason       String?

  // ხელით გაცემული გამოწერა (ადმინის მიერ) — ფასიანი გადახდის გარეშე
  grantedByUserId String?
  grantedNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

/**
 * კონსულტაციის პაკეტი — ცალკე ნაყიდი ლიმიტი.
 * გამოწერას არ ცვლის და არ აუქმებს: ეს დამატებაა და არა ახალი პაკეტი.
 * მშობელი მას მაშინ ყიდულობს, როცა თვის უფასო ვიზიტი ამოწურა და
 * ექიმთან საუბრის გაგრძელება უნდა.
 */
model ConsultationPack {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// კატალოგის კოდი: "day5", "week40", "month100"
  code      String
  /// რამდენი საუბარი შედის
  chatLimit Int
  /// რამდენი გამოიყენა
  used      Int    @default(0)

  expiresAt DateTime
  /// რომელი გადახდით შეიძინა
  paymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expiresAt])
  @@map("consultation_packs")
}

// ═══════════════════════════════════════════════════════════════════════════
// 3.1 პრომო კოდები
// ═══════════════════════════════════════════════════════════════════════════

enum PromoType {
  /// ფასდაკლება პროცენტში
  DISCOUNT
  /// კონკრეტული პაკეტი უფასოდ, გარკვეული ვადით
  FREE_PLAN
  /// ერთი უფასო ვიდეო ვიზიტი ექიმთან
  FREE_VIDEO_VISIT
}

model PromoCode {
  id          String    @id @default(uuid())
  code        String    @unique // მაგ: "BABY20"
  type        PromoType
  description String?

  /// DISCOUNT-ისთვის: 1–100
  discountPercent Int?

  /// FREE_PLAN-ისთვის: რომელი პაკეტი და რამდენი დღით
  planId   String?
  plan     Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  freeDays Int?

  /// FREE_VIDEO_VISIT-ისთვის: რამდენი უფასო ვიზიტი მიიღოს მშობელმა
  visitCount Int?

  /// კოდის მოქმედების ვადა
  validFrom  DateTime  @default(now())
  validUntil DateTime?

  /// გამოყენების ლიმიტი — null ნიშნავს ულიმიტოს
  maxRedemptions Int?
  redeemedCount  Int     @default(0)
  /// ერთ მომხმარებელს ერთხელ
  oncePerUser    Boolean @default(true)

  isActive    Boolean @default(true)
  createdById String?
  createdBy   User?   @relation("PromoAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  redemptions PromoRedemption[]

  @@index([isActive, validUntil])
  @@map("promo_codes")
}

model PromoRedemption {
  id      String    @id @default(uuid())
  promoId String
  promo   PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  createdAt      DateTime @default(now())

  @@unique([promoId, userId])
  @@index([userId])
  @@map("promo_redemptions")
}

// ═══════════════════════════════════════════════════════════════════════════
// 4. გადახდები — ჩარჩო მზადაა, provider მოგვიანებით ჩაერთვება
// ═══════════════════════════════════════════════════════════════════════════

enum PaymentProvider {
  MANUAL
  BOG
  TBC
  STRIPE
  APPLE_IAP
  GOOGLE_PLAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

model Payment {
  id String @id @default(uuid())

  // ანგარიშის მუდმივად წაშლისას გადახდა უნდა გადარჩეს — ეს ბუღალტრული
  // ჩანაწერია. ამიტომ კავშირი წყდება, თავად ჩანაწერი კი რჩება.
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  provider       PaymentProvider @default(MANUAL)
  status         PaymentStatus   @default(PENDING)
  currency       String          @default("GEL")
  amountMinor    Int

  providerPaymentId String? @unique
  failureReason     String?
  receiptUrl        String?
  metadata          Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, status])
  @@map("payments")
}

// გადამხდელი სისტემების webhook-ები — იდემპოტენტურობისთვის
model PaymentWebhookEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  externalId  String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime        @default(now())

  @@unique([provider, externalId])
  @@map("payment_webhook_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// 4.5 მედია — ერთი ცენტრალური მოდელი ყველა ფაილისთვის
// ═══════════════════════════════════════════════════════════════════════════

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

/// საიდან მოვიდა ფაილი — წვდომის წესები წყაროზეა დამოკიდებული
enum MediaSource {
  ADMIN
  CHAT
  PROFILE
  OTHER
}

/// საჯარო თუ ხელმოწერით — წვდომის რეჟიმი ცალსახად ინახება,
/// წყაროდან გამოყვანა მოგვიანებით შეცდომის წყარო გახდებოდა
enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

/**
 * ფაილის მეტამონაცემები. თავად ფაილი ბაზაში არასდროს ინახება —
 * მხოლოდ მისამართი პროვაიდერთან.
 * ერთი მოდელი ყველა ტიპისთვის: ავატარი, ჩატის დანართი, ადმინის ვიდეო.
 * ასე ატვირთვის, წაშლისა და ლიმიტების ლოგიკა ერთ ადგილასაა.
 */
model MediaAsset {
  id         String          @id @default(uuid())
  ownerId    String?
  owner      User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  type       MediaType
  source     MediaSource     @default(OTHER)
  status     MediaStatus     @default(READY)
  /// ნაგულისხმევად კერძო — საჯაროობა ცალსახად უნდა გამოცხადდეს
  visibility MediaVisibility @default(PRIVATE)

  /// R2 | BUNNY — რომელ საცავშია
  provider StorageProvider

  /// R2-ის ობიექტის key ან Bunny-ის asset id
  storageKey String
  /// დასაკრავი იდენტიფიკატორი (ვიდეოსთვის)
  playbackId String?
  /// საჯარო მისამართი — ივსება მხოლოდ visibility = PUBLIC-ზე.
  /// კერძო ფაილს ბმული ყოველ ჯერზე ხელმოწერით გამოაქვს.
  publicUrl  String?

  mimeType  String
  sizeBytes Int?
  width     Int?
  height    Int?
  /// წამებში — ვიდეოსა და აუდიოსთვის
  duration  Int?

  /// პროვაიდერისგან ბოლო მოვლენის დრო — debugging-ისთვის
  lastProviderEventAt DateTime?
  /// ჩავარდნის მიზეზი, თუ status = FAILED
  failureReason       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// რბილი წაშლა — ფიზიკურად background-ით იშლება
  deletedAt DateTime?

  /// ფაილი პროვაიდერიდან წაიშალა. ჩანაწერი ბაზაში რჩება —
  /// audit-სა და მიმართვების მთლიანობისთვის
  purgedAt         DateTime?
  purgeAttempts    Int       @default(0)
  /// შემდეგი მცდელობის დრო — exponential backoff
  purgeNextRetryAt DateTime?
  purgeLastError   String?

  events       MediaProviderEvent[]
  videos       Video[]              @relation("VideoAsset")
  childAvatars Child[]              @relation("ChildAvatar")
  thumbnailFor Video[]              @relation("VideoThumbnail")
  attachments  MessageAttachment[]

  @@index([ownerId, source])
  @@index([status, deletedAt])
  /// worker-ის რიგი — წაშლილი, ჯერ გაუწმენდავი ფაილები
  @@index([deletedAt, purgedAt, purgeNextRetryAt])
  @@map("media_assets")
}

/**
 * პროვაიდერის მოვლენების ჟურნალი.
 * ორი დანიშნულება აქვს:
 * 1. idempotency — ერთი და იგივე მოვლენა რამდენჯერაც მოვა, ერთხელ
 * დამუშავდება. `@@unique` სწორედ ამას იცავს.
 * 2. debugging — ჩანს, რა და როდის მოვიდა პროვაიდერისგან.
 */
model MediaProviderEvent {
  id       String          @id @default(uuid())
  assetId  String?
  asset    MediaAsset?     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  provider StorageProvider

  /// პროვაიდერის მოვლენის იდენტიფიკატორი (guid + status)
  externalId String
  eventType  String
  payload    Json

  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([assetId, createdAt])
  @@map("media_provider_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// 5. ვიდეო კონტენტი (Netflix-ის ლოგიკა)
// ═══════════════════════════════════════════════════════════════════════════

model VideoCategory {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  description String?
  coverUrl    String?
  parentId    String?
  parent      VideoCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    VideoCategory[] @relation("CategoryTree")
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos Video[]

  @@index([parentId])
  @@map("video_categories")
}

enum VideoStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
}

// ვიდეოზე წვდომის წესი — არ არის კოდში ჩაშენებული
enum VideoAccessType {
  FREE // ყველასთვის
  AUTHENTICATED // ავტორიზებულებისთვის
  SUBSCRIPTION // ნებისმიერი აქტიური ფასიანი გამოწერით
  SPECIFIC_PLANS // მხოლოდ VideoPlanAccess-ში ჩამოთვლილი პაკეტებით
}

enum StorageProvider {
  R2
  MUX
  CLOUDFLARE_STREAM
  BUNNY
  S3_CLOUDFRONT
}

model Video {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  description String?
  categoryId  String?
  category    VideoCategory? @relation(fields: [categoryId], references: [id])
  status      VideoStatus    @default(DRAFT)

  /// ფაილი MediaAsset-შია — Video მხოლოდ ბიზნეს-ინფორმაციას ატარებს
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation("VideoAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  thumbnailAssetId String?
  thumbnailAsset   MediaAsset? @relation("VideoThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  previewUrl String? // მოკლე hover-preview

  accessType VideoAccessType @default(SUBSCRIPTION)

  // ასაკობრივი მიზნობრიობა — ბავშვის ასაკის მიხედვით რეკომენდაციისთვის
  ageMinMonths Int?
  ageMaxMonths Int?

  tags       String[] @default([])
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  viewCount  Int      @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  planAccess VideoPlanAccess[]
  newsPosts  NewsPost[]
  progress   WatchProgress[]
  views      VideoView[]
  favorites  VideoFavorite[]

  @@index([status, categoryId])
  @@index([isFeatured, sortOrder])
  @@map("videos")
}

// SPECIFIC_PLANS-ისთვის: რომელი პაკეტი ხედავს რომელ ვიდეოს
model VideoPlanAccess {
  id      String @id @default(uuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  planId  String
  plan    Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([videoId, planId])
  @@map("video_plan_access")
}

// "გააგრძელე იქიდან სადაც შეწყვიტე"
model WatchProgress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId       String
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  positionSec   Int      @default(0)
  percent       Int      @default(0)
  isCompleted   Boolean  @default(false)
  lastWatchedAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId, lastWatchedAt])
  @@map("watch_progress")
}

// ნახვების ისტორია — ანალიტიკისთვის (WatchProgress-ისგან განსხვავებით append-only)
model VideoView {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  watchedSec Int      @default(0)
  deviceId   String?
  startedAt  DateTime @default(now())

  @@index([videoId, startedAt])
  @@index([userId, startedAt])
  @@map("video_views")
}

model VideoFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@map("video_favorites")
}

// ═══════════════════════════════════════════════════════════════════════════
// 5.1 სიახლეები — ადმინის განცხადებები მშობლებისთვის
// ═══════════════════════════════════════════════════════════════════════════

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model NewsPost {
  id       String     @id @default(uuid())
  title    String
  body     String
  status   NewsStatus @default(DRAFT)
  coverUrl String?

  /// სურვილისამებრ მიბმული ვიდეო
  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  /// true — გამოქვეყნებისას მშობლებს push/in-app შეტყობინება გაეგზავნათ
  notify        Boolean @default(true)
  /// რამდენ მომხმარებელს გაეგზავნა — ადმინს შედეგი უნდა ხედავდეს
  notifiedCount Int     @default(0)

  authorId String?
  author   User?   @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime?

  /// ადმინმა "გამოქვეყნება" აირჩია, ვიდეო კი ჯერ მუშავდებოდა — მზადყოფნისას
  /// webhook თვითონ გამოაქვეყნებს. ასე შავი კადრი მშობელს აღარ დახვდება.
  publishAfterVideo Boolean @default(false)

  /// ჩვენების ფანჯარა მთავარ გვერდზე. ცარიელი `visibleUntil` = უვადოდ.
  /// `publishedAt`-ისგან იმით განსხვავდება, რომ სიახლე შეიძლება უკვე
  /// გამოქვეყნებული იყოს, ჩვენება კი მოგვიანებით იწყებოდეს.
  visibleFrom  DateTime?
  visibleUntil DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, publishedAt])
  @@index([status, visibleFrom, visibleUntil])
  @@map("news_posts")
}

// ═══════════════════════════════════════════════════════════════════════════
// 6. ჩატი (მშობელი ↔ ოპერატორი), realtime WebSocket-ით
// ═══════════════════════════════════════════════════════════════════════════

enum ConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

/**
 * საუბრის სახეობა.
 * ვიდეო ვიზიტის ჩატი იმავე ცხრილში ცხოვრობს (დანართები, ისტორია და
 * წაკითხვის აღრიცხვა ერთი და იგივეა), მაგრამ ოპერატორის რიგში,
 * მშობლის ჩატების სიასა და წაუკითხავების მრიცხველში არ უნდა ჩანდეს —
 * ეს ცალკე სერვისია და პაკეტთან კავშირი არ აქვს.
 */
enum ConversationKind {
  /// მშობლის შეკითხვა ოპერატორთან
  SUPPORT
  /// ვიდეო ვიზიტის პარალელური ჩატი
  VIDEO_VISIT
}

model Conversation {
  id                 String             @id @default(uuid())
  subject            String?
  kind               ConversationKind   @default(SUPPORT)
  status             ConversationStatus @default(OPEN)
  assignedOperatorId String?

  /// ბოლოს გამოცხადებული ადგილი რიგში — გამეორებას კეტავს
  queueNoticePosition Int?
  lastMessageAt       DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  participants ConversationUser[]
  messages     Message[]
  feedback     ConversationFeedback?
  videoVisit   VideoVisit?

  @@index([kind, status, lastMessageAt])
  @@index([assignedOperatorId, status])
  @@map("conversations")
}

model ConversationUser {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  isMuted        Boolean      @default(false)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_users")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  SYSTEM
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // ავტორის წაშლისას შეტყობინება რჩება, თორემ მეორე მხარეს საუბარი
  // ნახევრად გაწყვეტილი დარჩებოდა.
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type           MessageType  @default(TEXT)
  body           String?

  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/**
 * შეტყობინების დანართები.
 * ცალკე ცხრილია იმიტომ, რომ ერთ შეტყობინებაში შეიძლება იყოს ტექსტი,
 * რამდენიმე ფოტო, ვიდეო და დოკუმენტი ერთდროულად. ერთი `attachmentUrl`
 * ველი ამას ვერ დაიტევდა და მოგვიანებით ბაზის გადაკეთებას მოითხოვდა.
 */
model MessageAttachment {
  id        String     @id @default(uuid())
  messageId String
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// ჩვენების რიგი შეტყობინების შიგნით
  position  Int        @default(0)

  createdAt DateTime @default(now())

  @@unique([messageId, assetId])
  @@index([assetId])
  @@map("message_attachments")
}

// ═══════════════════════════════════════════════════════════════════════════
// 7. Push Notification და SMS
// ═══════════════════════════════════════════════════════════════════════════

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model Device {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    DevicePlatform
  pushToken   String         @unique // Expo push token / FCM
  deviceModel String?
  appVersion  String?
  isActive    Boolean        @default(true)
  lastSeenAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([userId, isActive])
  @@map("devices")
}

enum NotificationChannel {
  PUSH
  IN_APP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

// შაბლონები — ტექსტი ბაზაშია, Admin ცვლის deploy-ის გარეშე
model NotificationTemplate {
  id        String              @id @default(uuid())
  key       String              @unique // "subscription_expiring", "new_video"
  title     String
  body      String // {{firstName}} სტილის placeholder-ები
  channel   NotificationChannel @default(PUSH)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("notification_templates")
}

model Notification {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     NotificationChannel @default(PUSH)
  status      NotificationStatus  @default(QUEUED)
  title       String
  body        String
  data        Json? // deep link: { screen: "VideoDetail", videoId: "..." }
  templateKey String?
  error       String?

  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, status, createdAt])
  @@map("notifications")
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model SmsTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_templates")
}

model SmsMessage {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone       String
  body        String
  templateKey String?
  provider    String? // "magti", "geosms", "twilio"
  providerRef String?
  status      SmsStatus @default(QUEUED)
  costMinor   Int?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([status])
  @@map("sms_messages")
}

// ═══════════════════════════════════════════════════════════════════════════
// 8. Audit Log და სისტემური პარამეტრები
// ═══════════════════════════════════════════════════════════════════════════

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  GRANT
  REVOKE
  PUBLISH
  EXPORT
}

// ვინ, რა, როდის შეცვალა — ყველა ადმინისეული მოქმედება აქ ჩაიწერება
model AuditLog {
  id          String      @id @default(uuid())
  actorId     String?
  actor       User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      AuditAction
  entityType  String // "Plan", "Video", "User"
  entityId    String?
  before      Json?
  after       Json?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// გლობალური პარამეტრები (მინიმალური აპ-ვერსია, maintenance mode, კონტაქტები)
enum MedicationDosingType {
  /// დოზა წონაზე ითვლება — მგ ერთ კილოგრამზე
  PER_KG
  /// დოზა ასაკობრივი საფეხურითაა და წონაზე არ იზრდება
  BY_AGE
}

/**
 * დოზის კალკულატორის ცნობარი.
 * კოდში არ იწერება: ექიმს უნდა შეეძლოს წამლის დამატება და დოზის
 * შესწორება პროგრამისტის გარეშე.
 * `ageBands` და `concentrations` JSON-ია განზრახ — ორივე მხოლოდ
 * წამალთან ერთად იკითხება, ცალკე არასდროს იძებნება და ერთიანად
 * რედაქტირდება; ცალკე ცხრილი მხოლოდ ფორმას ართულებდა.
 * ageBands:       [{ untilMonths, mg, label }]
 * concentrations: [{ label, mg, ml }]
 */
model Medication {
  id   String @id @default(uuid())
  name String
  slug String @unique

  dosingType MedicationDosingType @default(PER_KG)

  /// PER_KG-ისთვის: მგ ერთ კილოგრამზე, ერთჯერად მიღებაზე
  mgPerKgMin Float?
  mgPerKgMax Float?

  /// BY_AGE-ისთვის
  ageBands Json?

  /// მიღებებს შორის ინტერვალი საათებში
  intervalHoursMin Int
  intervalHoursMax Int

  /// მაქსიმალური თერაპიული დოზა 24 საათში, მგ
  maxDailyMg Float

  /// ამ ასაკამდე / ამ წონაზე ნაკლებზე დოზა არ გამოითვლება
  minAgeMonths Int   @default(0)
  minWeightKg  Float @default(0)

  concentrations Json @default("[]")

  note      String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// ექიმის მიერ ვიზიტზე დამატებული პრეპარატი.
  ///
  /// დოზირება ექიმმა ხელით შეიყვანა და პედიატრის დადასტურებამდე
  /// კალკულატორის საჯარო სიაში არ ჩნდება — ბავშვის დოზა შემოწმების
  /// გარეშე ვერ გავრცელდება.
  addedByDoctorId String?
  needsReview     Boolean @default(false)

  diagnoses DiagnosisMedication[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
  @@map("medications")
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false) // true = მობილურ აპს გადაეცემა
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

enum MilestoneDomain {
  /// უხეში მოტორიკა
  GROSS_MOTOR
  /// ნატიფი მოტორიკა
  FINE_MOTOR
  /// სოციალურ-ემოციური
  SOCIAL_EMOTIONAL
  /// კოგნიტური / მეტყველება
  COGNITIVE_LANGUAGE
}

enum MilestoneAnswer {
  YES
  SOMETIMES
  NOT_YET
  UNKNOWN
}

/**
 * განვითარების მონიტორინგის კითხვა.
 * ეს არ არის დიაგნოსტიკური ტესტი და არც ვალიდირებული სკრინინგის
 * ასლი — AAP-ის ტერმინოლოგიით ეს `developmental surveillance`-ია,
 * რომელიც ყოველ გეგმიურ ვიზიტზეა რეკომენდებული. ფორმალური სკრინინგი
 * (9, 18, 30 თვე) და ASD-ის სკრინინგი (18, 24 თვე) ექიმის საქმეა.
 * `ageMonths` — რომელ ასაკზე ფასდება ეს უნარი. კითხვა მოქმედია ამ
 * ასაკიდან: 6 თვის კითხვა 8 თვის ბავშვსაც უნდა ჰქონდეს შესრულებული,
 * ამიტომ შეფასებისას წინა თვეებიც მოწმდება.
 */
model MilestoneQuestion {
  id         String          @id @default(uuid())
  /// ადამიანისთვის წასაკითხი კოდი — მაგ. GM_06_01
  code       String          @unique
  ageMonths  Int
  domain     MilestoneDomain
  questionKa String

  /// true — ამ ასაკში შეუსრულებლობა ექიმთან მიმართვის ნიშანია
  redFlag   Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  answers MilestoneAnswerEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ageMonths, domain, sortOrder])
  @@map("milestone_questions")
}

/**
 * ერთი შევსებული კითხვარი.
 * `ageMonths` შენახვისას ფიქსირდება: ბავშვი იზრდება და ერთი წლის
 * შემდეგ შედეგი უაზრო იქნებოდა, თუ არ ვიცით, რა ასაკში შეივსო.
 */
model MilestoneAssessment {
  id        String @id @default(uuid())
  childId   String
  child     Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  ageMonths Int

  /// დომენების ჯამური სურათი — [{ domain, achieved, total, status }]
  summary    Json
  /// true — ერთი მაინც წითელი ალამი შეუსრულებელია
  hasRedFlag Boolean @default(false)

  answers MilestoneAnswerEntry[]

  createdAt DateTime @default(now())

  @@index([childId, createdAt])
  @@map("milestone_assessments")
}

model MilestoneAnswerEntry {
  id           String              @id @default(uuid())
  assessmentId String
  assessment   MilestoneAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     MilestoneQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       MilestoneAnswer

  @@unique([assessmentId, questionId])
  @@index([questionId])
  @@map("milestone_answers")
}

/**
 * შესვლის მეორე საფეხური.
 * სწორი პაროლის შემდეგ ტოკენი მაშინვე აღარ გაიცემა — იქმნება ეს
 * ჩანაწერი და ნომერზე მიდის კოდი. ტოკენს მხოლოდ კოდის დადასტურება
 * იძლევა.
 * კოდი ღიად არსად ინახება: ბაზაშია მხოლოდ argon2-ის hash, ისევე
 * როგორც პაროლი. ბაზის მოპარვაც კი კოდს არ ამხელს.
 */
model LoginChallenge {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  /// კლიენტს ეს id უბრუნდება — userId გარეთ არ გადის
  attempts Int    @default(0)
  /// რამდენჯერ გაიგზავნა ხელახლა — spam-ის საწინააღმდეგოდ
  resends  Int    @default(0)

  ipAddress String?
  userAgent String?
  deviceId  String?

  expiresAt  DateTime
  consumedAt DateTime?
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
  @@map("login_challenges")
}

/**
 * ნდობის მოწყობილობა — „დაიმახსოვრე ეს მოწყობილობა".
 * ტოკენი 32 შემთხვევითი ბაიტია და ბაზაში sha256-ითაა. argon2 აქ
 * ზედმეტია: ტოკენი გრძელია და გამოცნობა ისედაც შეუძლებელია, hash კი
 * მხოლოდ ბაზის გაჟონვისგან იცავს.
 */
model TrustedDevice {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String  @unique
  label     String?
  ipAddress String?
  userAgent String?

  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("trusted_devices")
}

// ═══════════════════════════════════════════════════════════════
// AI ასისტენტი — პრემიუმ პაკეტი
// ═══════════════════════════════════════════════════════════════

enum AiRole {
  USER
  ASSISTANT
}

/**
 * მშობლის საუბარი ასისტენტთან.
 * ოპერატორის ჩატისგან განზრახ ცალკეა: აქ მეორე მხარე ადამიანი არ არის,
 * პასუხზე პასუხისმგებლობა კი სხვაგვარად ნაწილდება.
 */
model AiConversation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// რომელ ბავშვზეა საუბარი — ასაკი პასუხს არსებითად ცვლის
  childId String?
  child   Child?  @relation(fields: [childId], references: [id], onDelete: SetNull)

  title String

  messages AiMessage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiRole
  content String

  /// ხარჯის აღრიცხვა — ლიმიტების დაწესება ციფრებს მოითხოვს
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ═══════════════════════════════════════════════════════════════
// ზრდის დინამიკა
// ═══════════════════════════════════════════════════════════════

/**
 * ერთი გაზომვა.
 * პროცენტილს განზრახ არ ვთვლით: ეს პედიატრის შეფასებაა და მშობელს
 * ციფრი დასკვნად მოეჩვენებოდა. აქ მხოლოდ ბავშვის საკუთარი მრუდია.
 */
model GrowthEntry {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  measuredAt DateTime

  weightKg Decimal? @db.Decimal(5, 2)
  heightCm Decimal? @db.Decimal(5, 1)
  headCm   Decimal? @db.Decimal(4, 1)

  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([childId, measuredAt])
  @@map("growth_entries")
}

// ═══════════════════════════════════════════════════════════════
// აცრების კალენდარი
// ═══════════════════════════════════════════════════════════════

/**
 * ეროვნული კალენდრის ერთი აცრა.
 * ცნობარი ბაზაშია და არა კოდში: კალენდარი იცვლება და ცვლილება
 * ადმინის პანელიდან უნდა შედიოდეს, აპლიკაციის განახლების გარეშე.
 */
model Vaccine {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  /// რისგან იცავს — მშობლისთვის ერთი წინადადებით
  description String?

  /// რომელ ასაკში კეთდება, თვეებში დაბადებიდან
  ageMonths  Int
  /// მრავალდოზიანი აცრის მერამდენე დოზაა
  doseNumber Int @default(1)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  records ChildVaccination[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ageMonths, sortOrder])
  @@map("vaccines")
}

/**
 * მოგზაურობის ჩეკლისტი — რა მოინიშნა ერთი ბავშვისთვის.
 * მონიშვნები მასივშია და არა ცალკე ცხრილში: სია მოკლეა და
 * ყოველთვის მთლიანად იკითხება, ერთ ჩანაწერს კი ცალკე ცხრილის
 * ათეული სტრიქონი არ სჭირდება.
 */
model TravelChecklist {
  id      String   @id @default(uuid())
  childId String   @unique
  child   Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// მონიშნული პუნქტების key-ები
  checked String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("travel_checklists")
}

/**
 * კონკრეტული ბავშვის აცრა — გაკეთებულია თუ არა და როდის.
 */
model ChildVaccination {
  id        String  @id @default(uuid())
  childId   String
  child     Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  vaccineId String
  vaccine   Vaccine @relation(fields: [vaccineId], references: [id], onDelete: Cascade)

  doneAt DateTime?
  note   String?

  /// შეხსენება უკვე გაიგზავნა — ერთი აცრა ორჯერ არ უნდა შეგვახსენებინოს
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childId, vaccineId])
  @@index([childId])
  @@map("child_vaccinations")
}

// ═══════════════════════════════════════════════════════════════
// ვიზიტის ჯავშანი
// ═══════════════════════════════════════════════════════════════

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELED
  DONE
}

/**
 * ვიზიტის მოთხოვნა პედიატრთან.
 * `usedFreeVisit` აღრიცხავს პაკეტის თვიურ უფასო ვიზიტს — თორემ
 * კვოტა მხოლოდ დაპირება იქნებოდა და არა წესი.
 */
model Appointment {
  id       String @id @default(uuid())
  parentId String
  parent   User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  childId String?
  child   Child?  @relation(fields: [childId], references: [id], onDelete: SetNull)

  /// მშობლის სასურველი დრო — არჩევითი: მშობელი უბრალოდ ითხოვს ვიზიტს,
  /// დროს ექიმი ნიშნავს
  preferredAt DateTime?
  reason      String?

  status      AppointmentStatus @default(REQUESTED)
  /// დადასტურებული დრო — შეიძლება სასურველს არ ემთხვეოდეს
  scheduledAt DateTime?
  staffNote   String?

  /// პაკეტის უფასო ვიზიტით იქმნება თუ ფასიანი
  usedFreeVisit Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId, createdAt])
  @@index([status, createdAt])
  @@map("appointments")
}

/**
 * დიაგნოზების ცნობარი.
 * ექიმი ხელახლა არ კრებს იმას, რაც ერთხელ უკვე დაწერა: ჩაწერილი
 * დიაგნოზი ცნობარში რჩება და შემდეგ ჯერზე პირველივე ასოებზე
 * ამოტივტივდება. ხშირად გამოყენებული ზემოთ დგება.
 * ნაწილი წინასწარ არის შევსებული, რომ სია ცარიელი არ დახვდეს.
 */
model DiagnosisEntry {
  id   String @id @default(uuid())
  name String @unique

  /// რა არის ეს დაავადება — მშობლისთვის გასაგები ენით.
  /// დასკვნაში ავტომატურად ჩაიწერება; ექიმს შეცვლა შეუძლია.
  description String?
  /// არამედიკამენტური რჩევა — რეჟიმი, სითხე, კონტროლი
  advice      String?

  /**
   * ონლაინ კონსულტაციით ვერ იმართება — ექიმი მას აფიქსირებს და
   * ოჯახს დაუყოვნებლივ სასწრაფო დახმარებაში აგზავნის.
   */
  isUrgent Boolean @default(false)

  /// რამდენჯერ დაისვა — სიის თანმიმდევრობას განსაზღვრავს
  usageCount Int     @default(0)
  /// წინასწარ შევსებული ჩანაწერი ექიმის დამატებულისგან განსხვავდება
  isBuiltIn  Boolean @default(false)
  isActive   Boolean @default(true)

  medications DiagnosisMedication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usageCount])
  @@map("diagnosis_entries")
}

/**
 * დიაგნოზი ↔ რეკომენდებული მედიკამენტი. დოზა წონაზე ითვლება.
 */
model DiagnosisMedication {
  id          String         @id @default(uuid())
  diagnosisId String
  diagnosis   DiagnosisEntry @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  /// როდის მიიღოს — „ცხელებაზე", „საჭიროებისამებრ"
  note     String?
  position Int     @default(0)

  @@unique([diagnosisId, medicationId])
  @@map("diagnosis_medications")
}

/**
 * ვიდეო ვიზიტი — ჩატისგან სრულიად ცალკე სერვისი.
 * ჩატი მიმოწერაა და პაკეტში შედის; ვიდეო ვიზიტი კი ერთჯერადი,
 * ცალკე ანაზღაურებადი შეხვედრაა ექიმთან. ამიტომ საკუთარი ცხრილი
 * აქვს და `Appointment`-ს არ იზიარებს — მათი ვადები, ლიმიტები და
 * მონაწილეები სხვადასხვაა.
 * მშობელი დღეს ირჩევს, ზუსტ საათს კი ექიმი ნიშნავს.
 */
enum VideoVisitStatus {
  /// გადახდილია, დღე არჩეულია, საათი ჯერ არა
  REQUESTED
  /// ექიმმა დანიშნა ზუსტი დრო
  SCHEDULED
  /// ორივე მხარე ჩაერთო
  LIVE
  DONE
  CANCELED
  /// დანიშნულ დროს არავინ გამოჩნდა
  NO_SHOW
}

/**
 * უფასო ვიზიტის უფლება.
 * პრომო კოდი ვიზიტს მაშინვე არ ქმნის — მშობელს ჯერ დღე უნდა აირჩიოს.
 * ამიტომ კოდი უფლებას ჩარიცხავს და ჯავშნისას ის გადახდას ცვლის.
 */
model VideoVisitCredit {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// საიდან მოვიდა: "promo", "grant" ან "late"
  source String
  note   String?

  /// ვიზიტის ღირებულების რამდენ პროცენტს ფარავს.
  ///
  /// 100 = სრულიად უფასო. დაგვიანების შემდეგ გაცემული უფლება 70-ია:
  /// მშობელს ნახევრად დახარჯული დრო არ უნდა დაუბრუნდეს სრულად,
  /// მაგრამ თანხის სრული დაკარგვაც უსამართლოა.
  coverPercent Int @default(100)

  usedAt  DateTime?
  visitId String?   @unique

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@map("video_visit_credits")
}

model VideoVisit {
  id       String @id @default(uuid())
  parentId String
  parent   User   @relation("VideoVisitParent", fields: [parentId], references: [id], onDelete: Cascade)

  childId String?
  child   Child?  @relation(fields: [childId], references: [id], onDelete: SetNull)

  /// მშობლის არჩეული დღე — დღის დასაწყისი
  requestedDate DateTime
  /// ექიმის დანიშნული ზუსტი დრო
  scheduledAt   DateTime?

  status VideoVisitStatus @default(REQUESTED)
  reason String?

  /// Agora-ს არხის სახელი — ორივე მხარე ერთსა და იმავეში შედის.
  /// შემთხვევითია, ამიტომ გამოცნობა შეუძლებელია; თავად არხი კი
  /// მოკლევადიანი ტოკენით იცავს თავს.
  roomName String @unique

  /// ვიზიტს ატარებს — მხოლოდ Super Admin
  staffId String?
  staff   User?   @relation("VideoVisitStaff", fields: [staffId], references: [id], onDelete: SetNull)

  /// ექიმის დასკვნა — ივსება ზარის დროს ან მის შემდეგ
  diagnosis        String?
  /// დიაგნოზის ახსნა — ცნობარიდან ავტომატურად, ექიმის რედაქტირებით
  diagnosisNote    String?
  prescription     String?
  /// ვიზიტის დროინდელი გაზომვები — დოზა სწორედ მათზეა დათვლილი
  visitHeightCm    Float?
  visitWeightKg    Float?
  /// როდის დაასრულა ექიმმა დასკვნა
  concludedAt      DateTime?
  /// როდის გაეგზავნა მშობელს — გამეორებას კეტავს
  conclusionSentAt DateTime?

  parentJoinedAt DateTime?
  staffJoinedAt  DateTime?
  /// ბოლო ნიშანი, რომ მხარე ჯერ კიდევ ოთახშია.
  ///
  /// მარტო „შემოვიდა" არ კმარა: ფანჯრის დახურვას სერვერი ვერ ხედავს
  /// და მეორე მხარე სამუდამოდ ფიქრობდა, რომ პარტნიორი ელოდება.
  parentSeenAt   DateTime?
  staffSeenAt    DateTime?

  /// შეხსენება გაგზავნილია თუ არა — ორმაგი SMS-ის დამცავი
  reminderSentAt DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  staffNote      String?

  /// საუბრის ჩატი — ტექსტი და ფოტოები ვიდეოს პარალელურად
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// რომელი გადახდით შეიძინა
  paymentId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([requestedDate, status])
  @@index([parentId, createdAt])
  @@index([scheduledAt])
  @@map("video_visits")
}

// ═══════════════════════════════════════════════════════════════
// ჩატის შეფასება
// ═══════════════════════════════════════════════════════════════

/**
 * მშობლის შეფასება დასრულებულ საუბარზე.
 * `token` იმისთვისაა, რომ SMS-ის ბმული ავტორიზაციის გარეშეც
 * გაიხსნას — მშობელი ტელეფონში შესული ხშირად არ არის, ხელახალი
 * შესვლის მოთხოვნა კი შეფასებას მოკლავდა.
 */
model ConversationFeedback {
  id             String       @id @default(uuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  parentId String?
  parent   User?   @relation(fields: [parentId], references: [id], onDelete: SetNull)

  /// ვინ დახურა საუბარი — შეფასების ძირითადი ადრესატი
  operatorId String?
  operator   User?   @relation("FeedbackOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  /// ერთ საუბარს რამდენიმე ოპერატორი პასუხობს — შეფასება ყველას ეკუთვნის
  operators ConversationFeedbackOperator[]

  token String @unique

  /// 1–5; ცარიელი = ჯერ არ შეუფასებია
  rating  Int?
  comment String?

  ratedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([operatorId, rating])
  @@map("conversation_feedback")
}

/**
 * შეფასების ავტორები.
 * ცალკე ცხრილია, რადგან ერთ საუბარს რამდენიმე ოპერატორი პასუხობს:
 * ერთი იწყებს, მეორე ცვლაში აგრძელებს. ერთი `operatorId` ქულას
 * მხოლოდ ბოლოს მიაწერდა და შედარება უაზრო გახდებოდა.
 */
model ConversationFeedbackOperator {
  id         String               @id @default(uuid())
  feedbackId String
  feedback   ConversationFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  operatorId String
  operator   User                 @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  /// რამდენი შეტყობინება დაწერა ამ საუბარში — წვლილის საზომი
  messageCount Int @default(0)

  createdAt DateTime @default(now())

  @@unique([feedbackId, operatorId])
  @@index([operatorId])
  @@map("conversation_feedback_operators")
}
